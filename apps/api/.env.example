# Copy this file to .env and fill in the key.
#
# There is no database and no authentication. The only value this service needs
# is a model key.

# The model. Every call goes through LiteLLM, so this is a provider prefixed
# name and changing provider is an environment change and not a code change.
SCRAP_MODEL="gemini/gemini-3.5-flash-lite"
GEMINI_API_KEY=""

LOG_LEVEL="INFO"
