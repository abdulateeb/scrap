# Copy this file to .env if you need to change the defaults.
#
# There is no database and no authentication in this application, so there is
# nothing secret here.

# Where the browser reaches apps/api. This path is rewritten by next.config.ts,
# so it stays a relative path and there is no cross origin request.
NEXT_PUBLIC_API_BASE_PATH="/api/scrap"

# Where the rewrite forwards to. Change only if the API runs on another host.
API_ORIGIN="http://127.0.0.1:5000"

# Largest file the upload control will accept, in bytes. Leave this unset to
# use 100 MB, which is the most the deployment platform will carry. A larger
# value is capped back down to that, because the request would be refused
# before it ever reached the service.
# NEXT_PUBLIC_MAX_UPLOAD_BYTES="104857600"
